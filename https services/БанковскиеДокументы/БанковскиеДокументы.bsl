// Модуль HTTP-сервиса. Имя функции должно совпадать с именем шаблона URL в конфигураторе.
// Банковские документы: платежные поручения и платежные ордера.
// В JSON у каждого документа: ТипДокумента, Номер, ДатаДокумента, Дата, Организация,
// Контрагент, СчетКасса, ВидОперации, Валюта, Ответственный, СуммаДокумента,
// Комментарий, Проведен, ПометкаУдаления.
// Без full - сводка ТабличныеЧасти вида Есть/Количество.
// При full - Реквизиты (все реквизиты шапки) и ТабличныеЧасти (все ТЧ построчно,
// каждая строка - пары ключ-значение по реквизитам ТЧ).
// Параметры: from, to; date; code; summ; approved;
// org, contractor, account, responsible, type; full.

Функция GetBankPayments(Запрос) Экспорт
	Возврат GetBankPayments_Impl(Запрос);
КонецФункции

Функция ПолучитьСтроковойПараметр(Запрос, ИмяПараметра)
	Значение = "";

	Попытка
		Значение = СокрЛП(Строка(Запрос.ПараметрыЗапроса.Получить(ИмяПараметра)));
	Исключение
		Значение = "";
	КонецПопытки;

	Если Значение = "" Тогда
		Попытка
			Значение = СокрЛП(Строка(Запрос.ПараметрыURL[ИмяПараметра]));
		Исключение
			Значение = "";
		КонецПопытки;
	КонецЕсли;

	Возврат Значение;
КонецФункции

Функция ПреобразоватьВБулево(СтрокаЛог)
	Если ПустаяСтрока(СтрокаЛог) Тогда
		Возврат Ложь;
	КонецЕсли;

	Стр = ВРег(СокрЛП(СтрокаЛог));
	Возврат Стр = "1" Или Стр = "TRUE" Или Стр = "YES" Или Стр = "ДА";
КонецФункции

Функция РазобратьДатуСтрокой(ЗначДата, КолЧастейДаты, ДлинаГода, ДлинаМесяца, ДлинаДня)
	Результат = Новый Структура;
	Результат.Вставить("Ок", Ложь);
	Результат.Вставить("Г", "");
	Результат.Вставить("М", "");
	Результат.Вставить("Д", "");

	Если Не ЗначениеЗаполнено(ЗначДата) Тогда
		Возврат Результат;
	КонецЕсли;

	Г = "";
	М = "";
	Д = "";
	ЧастиТочка = СтрРазделить(ЗначДата, ".", Ложь);
	ЧастиДефис = СтрРазделить(ЗначДата, "-", Ложь);

	Если ЧастиТочка.Количество() = КолЧастейДаты Тогда
		Д = ЧастиТочка[0];
		М = ЧастиТочка[1];
		Г = ЧастиТочка[2];
	ИначеЕсли ЧастиДефис.Количество() = КолЧастейДаты Тогда
		Если СтрДлина(СокрЛП(ЧастиДефис[0])) = ДлинаГода Тогда
			Г = ЧастиДефис[0];
			М = ЧастиДефис[1];
			Д = ЧастиДефис[2];
		Иначе
			Д = ЧастиДефис[0];
			М = ЧастиДефис[1];
			Г = ЧастиДефис[2];
		КонецЕсли;
	Иначе
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Г) Тогда
		Возврат Результат;
	КонецЕсли;

	Пока СтрДлина(Г) < ДлинаГода Цикл
		Г = "0" + Г;
	КонецЦикла;
	Пока СтрДлина(М) < ДлинаМесяца Цикл
		М = "0" + М;
	КонецЦикла;
	Пока СтрДлина(Д) < ДлинаДня Цикл
		Д = "0" + Д;
	КонецЦикла;

	Результат.Вставить("Ок", Истина);
	Результат.Вставить("Г", Г);
	Результат.Вставить("М", М);
	Результат.Вставить("Д", Д);
	Возврат Результат;
КонецФункции

Функция РазобратьПериодFromTo(ЗначFrom, ЗначTo, КолЧастейДаты, ДлинаГода, ДлинаМесяца, ДлинаДня, МассивОшибок)
	ПериодРезультат = Новый Структура;
	ПериодРезультат.Вставить("ИспользоватьПериод", Ложь);
	ПериодРезультат.Вставить("ДатаНачала", Дата(1, 1, 1));
	ПериодРезультат.Вставить("ДатаОкончания", Дата(1, 1, 1));

	Если Не ЗначениеЗаполнено(ЗначFrom) Или Не ЗначениеЗаполнено(ЗначTo) Тогда
		Возврат ПериодРезультат;
	КонецЕсли;

	П1 = РазобратьДатуСтрокой(ЗначFrom, КолЧастейДаты, ДлинаГода, ДлинаМесяца, ДлинаДня);
	П2 = РазобратьДатуСтрокой(ЗначTo, КолЧастейДаты, ДлинаГода, ДлинаМесяца, ДлинаДня);
	Если П1.Ок И П2.Ок Тогда
		ПериодРезультат.ДатаНачала = Дата(П1.Г + П1.М + П1.Д + "000000");
		ПериодРезультат.ДатаОкончания = КонецДня(Дата(П2.Г + П2.М + П2.Д + "000000"));
		ПериодРезультат.ИспользоватьПериод = Истина;
	Иначе
		МассивОшибок.Добавить("Некорректный формат from/to: " + ЗначFrom + " / " + ЗначTo);
	КонецЕсли;

	Возврат ПериодРезультат;
КонецФункции

Функция ПохожеНаЧисло(СтрокаЧисло)
	Если СтрокаЧисло = "" Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстЧисла = СтрЗаменить(СтрокаЧисло, ",", ".");
	ЕстьТочка = Ложь;
	Для Индекс = 1 По СтрДлина(ТекстЧисла) Цикл
		Символ = Сред(ТекстЧисла, Индекс, 1);
		Если Символ = "." Тогда
			Если ЕстьТочка Тогда
				Возврат Ложь;
			КонецЕсли;
			ЕстьТочка = Истина;
		ИначеЕсли Символ >= "0" И Символ <= "9" Тогда
			Продолжить;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

Функция СовпадаетПостФильтр(ЗначениеПоля, Подстрока)
	Возврат СтрНайти(ВРег(Строка(ЗначениеПоля)), ВРег(Подстрока)) > 0;
КонецФункции

Функция ПроходитСтроковыйПостФильтр(ИспользоватьФильтр, ЗначениеПоля, Подстрока)
	Если Не ИспользоватьФильтр Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СовпадаетПостФильтр(ЗначениеПоля, Подстрока);
КонецФункции

Функция ИменаДокументовМодуля()
	Имена = Новый Массив;
	Имена.Добавить("ПлатежноеПоручениеВходящее");
	Имена.Добавить("ПлатежноеПоручениеИсходящее");
	Имена.Добавить("ПлатежныйОрдерПоступлениеДенежныхСредств");
	Имена.Добавить("ПлатежныйОрдерСписаниеДенежныхСредств");

	Возврат Имена;
КонецФункции

Функция СобратьФильтры(Запрос, КолЧастейДаты, ДлинаГода, ДлинаМесяца, ДлинаДня, МассивОшибок)
	Фильтры = Новый Структура;
	ПараметрПолныйНижний = "full";
	ПараметрПолныйВерхний = ВРег(ПараметрПолныйНижний);
	ПозицияНачалаОстатка = 2;
	ПараметрПолныйСЗаглавной = ВРег(Лев(ПараметрПолныйНижний, 1))
		+ Сред(ПараметрПолныйНижний, ПозицияНачалаОстатка, СтрДлина(ПараметрПолныйНижний) - 1);

	ЗначFrom = ПолучитьСтроковойПараметр(Запрос, "from");
	ЗначTo = ПолучитьСтроковойПараметр(Запрос, "to");
	ПериодРезультат = РазобратьПериодFromTo(
		ЗначFrom,
		ЗначTo,
		КолЧастейДаты,
		ДлинаГода,
		ДлинаМесяца,
		ДлинаДня,
		МассивОшибок);
	Фильтры.Вставить("ИспользоватьПериод", ПериодРезультат.ИспользоватьПериод);
	Фильтры.Вставить("ДатаНачала", ПериодРезультат.ДатаНачала);
	Фильтры.Вставить("ДатаОкончания", ПериодРезультат.ДатаОкончания);

	ЗначCode = ПолучитьСтроковойПараметр(Запрос, "code");
	Фильтры.Вставить("ИспользоватьФильтрНомер", ЗначCode <> "");
	Фильтры.Вставить("НомерШаблон", ?(ЗначCode <> "", "%" + ЗначCode + "%", "%"));

	ИспользоватьФильтрДата = Ложь;
	ДатаФильтр = Дата(1, 1, 1);
	ДатаФильтрКонец = Дата(1, 1, 1);
	ЗначDate = ПолучитьСтроковойПараметр(Запрос, "date");
	Если ЗначDate <> "" Тогда
		П = РазобратьДатуСтрокой(ЗначDate, КолЧастейДаты, ДлинаГода, ДлинаМесяца, ДлинаДня);
		Если П.Ок Тогда
			ДатаФильтр = Дата(П.Г + П.М + П.Д + "000000");
			ДатаФильтрКонец = КонецДня(ДатаФильтр);
			ИспользоватьФильтрДата = Истина;
		Иначе
			МассивОшибок.Добавить("Некорректный параметр date: " + ЗначDate);
		КонецЕсли;
	КонецЕсли;
	Фильтры.Вставить("ИспользоватьФильтрДата", ИспользоватьФильтрДата);
	Фильтры.Вставить("ДатаФильтр", ДатаФильтр);
	Фильтры.Вставить("ДатаФильтрКонец", ДатаФильтрКонец);

	ЗначSumm = ПолучитьСтроковойПараметр(Запрос, "summ");
	Фильтры.Вставить("ИспользоватьФильтрСумма", ПохожеНаЧисло(ЗначSumm));
	Фильтры.Вставить("СуммаФильтр", ?(ПохожеНаЧисло(ЗначSumm), Число(ЗначSumm), 0));

	ЗначApproved = ПолучитьСтроковойПараметр(Запрос, "approved");
	Фильтры.Вставить("ИспользоватьФильтрПроведен", ЗначApproved <> "");
	Фильтры.Вставить("ПроведенФильтр", ПреобразоватьВБулево(ЗначApproved));

	ЗначПолный = ПолучитьСтроковойПараметр(Запрос, ПараметрПолныйНижний);
	Если ЗначПолный = "" Тогда
		ЗначПолный = ПолучитьСтроковойПараметр(Запрос, ПараметрПолныйСЗаглавной);
	КонецЕсли;
	Если ЗначПолный = "" Тогда
		ЗначПолный = ПолучитьСтроковойПараметр(Запрос, ПараметрПолныйВерхний);
	КонецЕсли;
	Фильтры.Вставить("ПолныйОтвет", ПреобразоватьВБулево(ЗначПолный));

	ЗначOrg = ПолучитьСтроковойПараметр(Запрос, "org");
	Фильтры.Вставить("ИспользоватьФильтрОрганизация", ЗначOrg <> "");
	Фильтры.Вставить("ПодстрокаОрганизация", ЗначOrg);

	ЗначContractor = ПолучитьСтроковойПараметр(Запрос, "contractor");
	Если ЗначContractor = "" Тогда
		ЗначContractor = ПолучитьСтроковойПараметр(Запрос, "contactor");
	КонецЕсли;
	Фильтры.Вставить("ИспользоватьФильтрКонтрагент", ЗначContractor <> "");
	Фильтры.Вставить("ПодстрокаКонтрагент", ЗначContractor);

	ЗначAccount = ПолучитьСтроковойПараметр(Запрос, "account");
	Фильтры.Вставить("ИспользоватьФильтрСчет", ЗначAccount <> "");
	Фильтры.Вставить("ПодстрокаСчет", ЗначAccount);

	ЗначResponsible = ПолучитьСтроковойПараметр(Запрос, "responsible");
	Фильтры.Вставить("ИспользоватьФильтрОтветственный", ЗначResponsible <> "");
	Фильтры.Вставить("ПодстрокаОтветственный", ЗначResponsible);

	ЗначType = ПолучитьСтроковойПараметр(Запрос, "type");
	Фильтры.Вставить("ИспользоватьФильтрТип", ЗначType <> "");
	Фильтры.Вставить("ПодстрокаТип", ЗначType);

	Возврат Фильтры;
КонецФункции

Функция ПроходитПостФильтры(Выборка, Фильтры)
	Возврат
		ПроходитСтроковыйПостФильтр(
			Фильтры.ИспользоватьФильтрОрганизация,
			Выборка.Организация,
			Фильтры.ПодстрокаОрганизация)
		И ПроходитСтроковыйПостФильтр(
			Фильтры.ИспользоватьФильтрКонтрагент,
			Выборка.Контрагент,
			Фильтры.ПодстрокаКонтрагент)
		И ПроходитСтроковыйПостФильтр(
			Фильтры.ИспользоватьФильтрСчет,
			Выборка.СчетКасса,
			Фильтры.ПодстрокаСчет)
		И ПроходитСтроковыйПостФильтр(
			Фильтры.ИспользоватьФильтрОтветственный,
			Выборка.Ответственный,
			Фильтры.ПодстрокаОтветственный)
		И ПроходитСтроковыйПостФильтр(
			Фильтры.ИспользоватьФильтрТип,
			Выборка.ТипДокумента,
			Фильтры.ПодстрокаТип);
КонецФункции

Функция ТекстУсловийОтбора(Фильтры)
	УсловияГде = "";

	Если Фильтры.ИспользоватьПериод Тогда
		УсловияГде = УсловияГде + "
			|	И Док.Дата >= &ДатаНачала
			|	И Док.Дата <= &ДатаОкончания";
	КонецЕсли;
	Если Фильтры.ИспользоватьФильтрНомер Тогда
		УсловияГде = УсловияГде + "
			|	И Док.Номер ПОДОБНО &НомерШаблон";
	КонецЕсли;
	Если Фильтры.ИспользоватьФильтрДата Тогда
		УсловияГде = УсловияГде + "
			|	И Док.Дата >= &ДатаФильтр
			|	И Док.Дата <= &ДатаФильтрКонец";
	КонецЕсли;
	Если Фильтры.ИспользоватьФильтрСумма Тогда
		УсловияГде = УсловияГде + "
			|	И Док.СуммаДокумента = &СуммаФильтр";
	КонецЕсли;
	Если Фильтры.ИспользоватьФильтрПроведен Тогда
		УсловияГде = УсловияГде + "
			|	И Док.Проведен = &ПроведенФильтр";
	КонецЕсли;

	Возврат УсловияГде;
КонецФункции

Функция ТекстВеткиЗапроса(ИмяДокумента, ИмяПараметраТипа, УсловияГде)
	Возврат
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(&" + ИмяПараметраТипа + " КАК СТРОКА(150)) КАК ТипДокумента,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК ДатаДокумента,
	|	ПРЕДСТАВЛЕНИЕ(Док.Организация) КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(Док.Контрагент) КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Док.СчетОрганизации) КАК СчетКасса,
	|	ПРЕДСТАВЛЕНИЕ(Док.ВидОперации) КАК ВидОперации,
	|	ПРЕДСТАВЛЕНИЕ(Док.ВалютаДокумента) КАК Валюта,
	|	ПРЕДСТАВЛЕНИЕ(Док.Ответственный) КАК Ответственный,
	|	Док.СуммаДокумента КАК СуммаДокумента,
	|	Док.Проведен КАК Проведен,
	|	Док.ПометкаУдаления КАК ПометкаУдаления,
	|	Док.Комментарий КАК Комментарий
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Док
	|ГДЕ
	|	1 = 1" + УсловияГде;
КонецФункции

Функция ИменаДокументовДляОтбора(Фильтры)
	Имена = Новый Массив;

	Для Каждого ИмяДокумента Из ИменаДокументовМодуля() Цикл
		Если Не Фильтры.ИспользоватьФильтрТип Тогда
			Имена.Добавить(ИмяДокумента);
		ИначеЕсли СовпадаетПостФильтр(ИмяДокумента, Фильтры.ПодстрокаТип) Тогда
			Имена.Добавить(ИмяДокумента);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;
КонецФункции

Функция СобратьТекстЗапроса(ЗапросБД, Фильтры, УсловияГде)
	ТекстЗапроса = "";
	Индекс = 0;

	Для Каждого ИмяДокумента Из ИменаДокументовДляОтбора(Фильтры) Цикл
		Индекс = Индекс + 1;
		ИмяПараметраТипа = "ТипДок" + Формат(Индекс, "ЧГ=0");
		Ветка = ТекстВеткиЗапроса(ИмяДокумента, ИмяПараметраТипа, УсловияГде);
		Если ТекстЗапроса = "" Тогда
			ТекстЗапроса = Ветка;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|" + Ветка;
		КонецЕсли;
		ЗапросБД.УстановитьПараметр(ИмяПараметраТипа, ИмяДокумента);
	КонецЦикла;

	Если ТекстЗапроса = "" Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекстЗапроса + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента УБЫВ,
	|	Номер УБЫВ";
КонецФункции

Функция ПолучитьВыборкуДокументов(Фильтры, МассивОшибок)
	ЗапросБД = Новый Запрос;
	УсловияГде = ТекстУсловийОтбора(Фильтры);
	ТекстЗапроса = СобратьТекстЗапроса(ЗапросБД, Фильтры, УсловияГде);

	Если ТекстЗапроса = "" Тогда
		МассивОшибок.Добавить("Параметр type не соответствует ни одному типу документа этого сервиса: "
			+ Фильтры.ПодстрокаТип);
		Возврат Неопределено;
	КонецЕсли;

	ЗапросБД.Текст = ТекстЗапроса;
	ЗапросБД.УстановитьПараметр("ДатаНачала", Фильтры.ДатаНачала);
	ЗапросБД.УстановитьПараметр("ДатаОкончания", Фильтры.ДатаОкончания);
	ЗапросБД.УстановитьПараметр("НомерШаблон", Фильтры.НомерШаблон);
	ЗапросБД.УстановитьПараметр("ДатаФильтр", Фильтры.ДатаФильтр);
	ЗапросБД.УстановитьПараметр("ДатаФильтрКонец", Фильтры.ДатаФильтрКонец);
	ЗапросБД.УстановитьПараметр("СуммаФильтр", Фильтры.СуммаФильтр);
	ЗапросБД.УстановитьПараметр("ПроведенФильтр", Фильтры.ПроведенФильтр);

	Возврат ЗапросБД.Выполнить().Выбрать();
КонецФункции

Функция СтрокаДатыДокумента(ДатаДокумента)
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
КонецФункции

Функция ТекстПоляИлиЗаглушка(Значение, Заглушка)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Заглушка;
	КонецЕсли;

	Возврат Значение;
КонецФункции

Функция ТекстПоляИлиПусто(Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Значение;
КонецФункции

Функция СуммаДокументаДляОтвета(СуммаДокумента)
	Если Не ЗначениеЗаполнено(СуммаДокумента) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат СуммаДокумента;
КонецФункции

Функция ЗначениеДляJSON(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат СтрокаДатыДокумента(Значение);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);
КонецФункции

Функция СформироватьСтрокуТабличнойЧасти(СтрокаТЧ, МетаданныеТЧ)
	СтрокаОтвета = Новый Структура;
	ТекстНомераСтроки = Строка(СтрокаТЧ.НомерСтроки);
	СтрокаОтвета.Вставить("НомерСтроки", ТекстНомераСтроки);

	Для Каждого РеквизитМД Из МетаданныеТЧ.Реквизиты Цикл
		ИмяРеквизита = РеквизитМД.Имя;
		ЗначениеРеквизита = ЗначениеДляJSON(СтрокаТЧ[ИмяРеквизита]);
		СтрокаОтвета.Вставить(ИмяРеквизита, ЗначениеРеквизита);
	КонецЦикла;

	Возврат СтрокаОтвета;
КонецФункции

Функция СформироватьСтрокиТабличнойЧасти(ТабличнаяЧасть, МетаданныеТЧ)
	Строки = Новый Массив;

	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		СтрокаОтвета = СформироватьСтрокуТабличнойЧасти(СтрокаТЧ, МетаданныеТЧ);
		Строки.Добавить(СтрокаОтвета);
	КонецЦикла;

	Возврат Строки;
КонецФункции

Функция СформироватьТабличныеЧасти(ОбъектДокумента)
	ТабличныеЧасти = Новый Структура;

	Для Каждого МетаданныеТЧ Из ОбъектДокумента.Метаданные().ТабличныеЧасти Цикл
		ИмяТЧ = МетаданныеТЧ.Имя;
		Строки = СформироватьСтрокиТабличнойЧасти(ОбъектДокумента[ИмяТЧ], МетаданныеТЧ);
		ТабличныеЧасти.Вставить(ИмяТЧ, Строки);
	КонецЦикла;

	Возврат ТабличныеЧасти;
КонецФункции

Функция СформироватьРеквизитыШапки(ОбъектДокумента)
	Реквизиты = Новый Структура;

	Для Каждого РеквизитМД Из ОбъектДокумента.Метаданные().Реквизиты Цикл
		ИмяРеквизита = РеквизитМД.Имя;
		ЗначениеРеквизита = ЗначениеДляJSON(ОбъектДокумента[ИмяРеквизита]);
		Реквизиты.Вставить(ИмяРеквизита, ЗначениеРеквизита);
	КонецЦикла;

	Возврат Реквизиты;
КонецФункции

Функция КоличествоСтрокТабличныхЧастей(ОбъектДокумента)
	Итого = 0;

	Для Каждого МетаданныеТЧ Из ОбъектДокумента.Метаданные().ТабличныеЧасти Цикл
		ИмяТЧ = МетаданныеТЧ.Имя;
		Итого = Итого + ОбъектДокумента[ИмяТЧ].Количество();
	КонецЦикла;

	Возврат Итого;
КонецФункции

Функция ПолучитьОбъектДокумента(Выборка, МассивОшибок)
	ОбъектДокумента = Неопределено;

	Попытка
		ОбъектДокумента = Выборка.Ссылка.ПолучитьОбъект();
	Исключение
		ОбъектДокумента = Неопределено;
		ТекстОшибкиЧтения = "Документ №" + Выборка.Номер + ": ошибка чтения объекта - " + ОписаниеОшибки();
		МассивОшибок.Добавить(ТекстОшибкиЧтения);
	КонецПопытки;

	Возврат ОбъектДокумента;
КонецФункции

Процедура ДобавитьПолныйОтветДокумента(ДокументОтвета, ОбъектДокумента)
	РеквизитыШапки = СформироватьРеквизитыШапки(ОбъектДокумента);
	ТабличныеЧасти = СформироватьТабличныеЧасти(ОбъектДокумента);

	ДокументОтвета.Вставить("Реквизиты", РеквизитыШапки);
	ДокументОтвета.Вставить("ТабличныеЧасти", ТабличныеЧасти);
КонецПроцедуры

Процедура ДобавитьКраткийОтветДокумента(ДокументОтвета, ОбъектДокумента)
	КоличествоСтрок = КоличествоСтрокТабличныхЧастей(ОбъектДокумента);
	Сводка = Новый Структура("Есть, Количество", КоличествоСтрок > 0, КоличествоСтрок);

	ДокументОтвета.Вставить("ТабличныеЧасти", Сводка);
КонецПроцедуры

Процедура ДобавитьПустойОтветДокумента(ДокументОтвета, Фильтры)
	Если Фильтры.ПолныйОтвет Тогда
		ДокументОтвета.Вставить("Реквизиты", Новый Структура);
		ДокументОтвета.Вставить("ТабличныеЧасти", Новый Структура);
	Иначе
		ПустаяСводка = Новый Структура("Есть, Количество", Ложь, 0);
		ДокументОтвета.Вставить("ТабличныеЧасти", ПустаяСводка);
	КонецЕсли;
КонецПроцедуры

Функция ЗаполнитьШапкуДокумента(Выборка)
	ДокументОтвета = Новый Структура;
	СтрокаДаты = СтрокаДатыДокумента(Выборка.ДатаДокумента);
	ТекстНеУказана = "Не указана";
	ТекстНеУказан = "Не указан";
	ТекстКомментария = ?(ЗначениеЗаполнено(Выборка.Комментарий), Выборка.Комментарий, "");
	ТекстТипаДокумента = СокрЛП(Выборка.ТипДокумента);
	ТекстНомера = СокрЛП(Выборка.Номер);

	ДокументОтвета.Вставить("ТипДокумента", ТекстТипаДокумента);
	ДокументОтвета.Вставить("Номер", ТекстНомера);
	ДокументОтвета.Вставить("ДатаДокумента", СтрокаДаты);
	ДокументОтвета.Вставить("Дата", СтрокаДаты);
	ДокументОтвета.Вставить("Организация", ТекстПоляИлиЗаглушка(Выборка.Организация, ТекстНеУказана));
	ДокументОтвета.Вставить("Контрагент", ТекстПоляИлиЗаглушка(Выборка.Контрагент, ТекстНеУказан));
	ДокументОтвета.Вставить("СчетКасса", ТекстПоляИлиЗаглушка(Выборка.СчетКасса, ТекстНеУказан));
	ДокументОтвета.Вставить("ВидОперации", ТекстПоляИлиПусто(Выборка.ВидОперации));
	ДокументОтвета.Вставить("Валюта", ТекстПоляИлиПусто(Выборка.Валюта));
	ДокументОтвета.Вставить("Ответственный", ТекстПоляИлиЗаглушка(Выборка.Ответственный, ТекстНеУказан));
	ДокументОтвета.Вставить("СуммаДокумента", СуммаДокументаДляОтвета(Выборка.СуммаДокумента));
	ДокументОтвета.Вставить("Комментарий", ТекстКомментария);
	ДокументОтвета.Вставить("Проведен", Выборка.Проведен);
	ДокументОтвета.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);

	Возврат ДокументОтвета;
КонецФункции

Функция СформироватьДокументИзВыборки(Выборка, Фильтры, МассивОшибок)
	ДокументОтвета = ЗаполнитьШапкуДокумента(Выборка);
	ОбъектДокумента = ПолучитьОбъектДокумента(Выборка, МассивОшибок);

	Если ОбъектДокумента = Неопределено Тогда
		ДобавитьПустойОтветДокумента(ДокументОтвета, Фильтры);
	ИначеЕсли Фильтры.ПолныйОтвет Тогда
		ДобавитьПолныйОтветДокумента(ДокументОтвета, ОбъектДокумента);
	Иначе
		ДобавитьКраткийОтветДокумента(ДокументОтвета, ОбъектДокумента);
	КонецЕсли;

	Возврат ДокументОтвета;
КонецФункции

Функция ДокументСериализуетсяВJSON(ДокументОтвета)
	Попытка
		ТестоваяЗаписьJSON = Новый ЗаписьJSON;
		ТестоваяЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ТестоваяЗаписьJSON, ДокументОтвета);
		ТестоваяЗаписьJSON.Закрыть();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция СоздатьУспешныйОтвет(МассивДокументов, МассивОшибок)
	HTTPСтатусУспеха = 200;
	ИтоговыйРезультат = Новый Структура;
	ИтоговыйРезультат.Вставить("data", МассивДокументов);
	ИтоговыйРезультат.Вставить("errors", МассивОшибок);

	JSON = Новый ЗаписьJSON;
	JSON.УстановитьСтроку();
	ЗаписатьJSON(JSON, ИтоговыйРезультат);
	JSONСтрока = JSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(HTTPСтатусУспеха);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(JSONСтрока);
	Возврат Ответ;
КонецФункции

Функция СоздатьОтветОшибки(ТекстОшибки)
	HTTPСтатусВнутренняяОшибкаСервера = 500;
	ДанныеОшибки = Новый Структура("error", ТекстОшибки);
	JSONОшибки = Новый ЗаписьJSON;
	JSONОшибки.УстановитьСтроку();
	ЗаписатьJSON(JSONОшибки, ДанныеОшибки);

	Ответ = Новый HTTPСервисОтвет(HTTPСтатусВнутренняяОшибкаСервера);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(JSONОшибки.Закрыть());
	Возврат Ответ;
КонецФункции

Функция GetBankPayments_Impl(Запрос)
	МассивДокументов = Новый Массив;
	МассивОшибок = Новый Массив;
	КолЧастейДаты = СтрДлина("000");
	ДлинаГода = СтрДлина("0000");
	ДлинаМесяца = СтрДлина("00");
	ДлинаДня = СтрДлина("00");

	Попытка
		Фильтры = СобратьФильтры(Запрос, КолЧастейДаты, ДлинаГода, ДлинаМесяца, ДлинаДня, МассивОшибок);
		Выборка = ПолучитьВыборкуДокументов(Фильтры, МассивОшибок);
		Если Выборка = Неопределено Тогда
			Возврат СоздатьУспешныйОтвет(МассивДокументов, МассивОшибок);
		КонецЕсли;

		Пока Выборка.Следующий() Цикл
			Если Не ПроходитПостФильтры(Выборка, Фильтры) Тогда
				Продолжить;
			КонецЕсли;

			ДокументОтвета = СформироватьДокументИзВыборки(Выборка, Фильтры, МассивОшибок);
			Если ДокументСериализуетсяВJSON(ДокументОтвета) Тогда
				МассивДокументов.Добавить(ДокументОтвета);
			Иначе
				СтрокаДатыДок = СтрокаДатыДокумента(Выборка.ДатаДокумента);
				ТекстОшибкиСериализации = "Проблема в документе №" + Выборка.Номер + " от "
					+ СтрокаДатыДок + ". Ошибка сериализации JSON.";
				МассивОшибок.Добавить(ТекстОшибкиСериализации);
			КонецЕсли;
		КонецЦикла;

		Возврат СоздатьУспешныйОтвет(МассивДокументов, МассивОшибок);
	Исключение
		Возврат СоздатьОтветОшибки(ОписаниеОшибки());
	КонецПопытки;
КонецФункции
